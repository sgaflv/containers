#!/usr/bin/env bash

set -euo pipefail

AGENT_NAME="OpenCode"
AGENT_CONTAINERFILE=""
AGENT_IMAGE_NAME="opencode-dev:latest"
CONTAINER_NAME=""

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

AGENT_CONTAINERFILE="$SCRIPT_DIR/Containerfile-opencode"

PROJECT_NAME="$(basename "$(realpath "$(pwd)")")"
CONTAINER_NAME="opencode-${PROJECT_NAME}"

# shellcheck source=run-agent-common.sh
source "$SCRIPT_DIR/run-agent-common.sh"


prepare_persistent_state() {
    mkdir -p "$HOME/.config/opencode"
    mkdir -p "$HOME/.local/state/opencode"
    mkdir -p "$HOME/.local/share/opencode"
}


run_new_container() {
    exec podman run -it \
        --name "$CONTAINER_NAME" \
        --userns=keep-id \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --network=host \
        -e XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
        -e HOME=/home/agentuser \
        -e XDG_CONFIG_HOME=/home/agentuser/.config \
        -e XDG_DATA_HOME=/home/agentuser/.local/share \
        -e XDG_CACHE_HOME=/home/agentuser/.cache \
        -e ANDROID_HOME=/home/agentuser/Android/Sdk \
        -v "$HOME/.local/share/opencode:/home/agentuser/.local/share/opencode:rw,Z" \
        -v "$HOME/.local/state/opencode:/home/agentuser/.local/state/opencode:rw,Z" \
        -v "$HOME/.config/opencode:/home/agentuser/.config/opencode:rw,Z" \
        -v "$PROJECT_DIR:$CONTAINER_PROJECT_DIR:rw,Z" \
        -w "$CONTAINER_PROJECT_DIR" \
        "$AGENT_IMAGE_NAME"
}


run_agent "$@"
