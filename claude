#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="$(realpath "$(pwd)")"
PROJECT_NAME="$(basename "$PROJECT_DIR")"

# Resolve the repo location from this script, so it works from any checkout.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CONTAINERFILE_DIR="$SCRIPT_DIR"

BASE_CONTAINERFILE="$CONTAINERFILE_DIR/Containerfile-agent-base"
CLAUDE_CONTAINERFILE="$CONTAINERFILE_DIR/Containerfile-claude"

BASE_IMAGE_NAME="agent-base:latest"
IMAGE_NAME="claude-dev:latest"

# One container per project, so the bind mount can never point at
# a different project after the container has been created.
CONTAINER_NAME="claude-${PROJECT_NAME}"

# The project gets its own stable path inside the container:
#
#   /workspace/some_game
#
CONTAINER_PROJECT_DIR="/workspace/${PROJECT_NAME}"


# ===========================================================================
# Remove all Claude containers and images
#
# Usage:
#
#   ./run-claude.sh rm
#
# This removes:
#
#   claude-* containers
#   claude-dev:latest
#
# Then it attempts to remove:
#
#   agent-base:latest
#
# If agent-base is still referenced by another container (for example an
# OpenCode container), the base image is NOT forcibly removed. The blocking
# containers are reported and the script exits with an error.
# ===========================================================================

remove_all() {
    echo "============================================================"
    echo "Removing Claude containers and images"
    echo "============================================================"
    echo

    # -----------------------------------------------------------------------
    # Find all Claude containers.
    #
    # We use the container name rather than the current project name so this
    # removes Claude containers belonging to every project.
    # -----------------------------------------------------------------------

    mapfile -t CLAUDE_CONTAINERS < <(
        podman ps -a \
            --format '{{.Names}}' \
            | grep '^claude-' \
            || true
    )

    if ((${#CLAUDE_CONTAINERS[@]} == 0)); then
        echo "No Claude containers found."
    else
        echo "Claude containers to remove:"

        for container in "${CLAUDE_CONTAINERS[@]}"; do
            echo "  $container"
        done

        echo

        # Remove both running and stopped containers.
        for container in "${CLAUDE_CONTAINERS[@]}"; do
            echo "Removing container: $container"
            podman rm -f "$container"
        done
    fi

    echo

    # -----------------------------------------------------------------------
    # Remove Claude image.
    # -----------------------------------------------------------------------

    if podman image exists "$IMAGE_NAME"; then
        echo "Removing Claude image: $IMAGE_NAME"

        if ! podman rmi "$IMAGE_NAME"; then
            echo
            echo "ERROR: Could not remove Claude image '$IMAGE_NAME'."
            echo "The image is still referenced by one or more containers."
            echo
            echo "Containers referencing this image:"

            podman ps -a \
                --filter "ancestor=$IMAGE_NAME" \
                --format '  {{.Names}}'

            exit 1
        fi
    else
        echo "Claude image '$IMAGE_NAME' does not exist."
    fi

    echo

    # -----------------------------------------------------------------------
    # Remove base image.
    #
    # Do NOT use --force here.
    #
    # If OpenCode or another derived container still exists, Podman will
    # refuse to remove the base image. We report the blocking containers.
    # -----------------------------------------------------------------------

    if podman image exists "$BASE_IMAGE_NAME"; then
        echo "Removing base image: $BASE_IMAGE_NAME"

        if ! podman rmi "$BASE_IMAGE_NAME"; then
            echo
            echo "ERROR: Could not remove base image '$BASE_IMAGE_NAME'."
            echo
            echo "The base image is still referenced by existing containers."
            echo "This may include OpenCode containers."
            echo
            echo "Containers referencing '$BASE_IMAGE_NAME':"

            BLOCKING_CONTAINERS="$(
                podman ps -a \
                    --filter "ancestor=$BASE_IMAGE_NAME" \
                    --format '  {{.Names}}' \
                    || true
            )"

            if [[ -n "$BLOCKING_CONTAINERS" ]]; then
                echo "$BLOCKING_CONTAINERS"
            else
                echo "  Unable to determine the referencing containers."
                echo "  Use:"
                echo "    podman ps -a"
            fi

            echo
            echo "Base image was NOT forcibly removed."
            echo "Remove those containers first, then run:"
            echo "  $0 rm"
            echo

            exit 1
        fi
    else
        echo "Base image '$BASE_IMAGE_NAME' does not exist."
    fi

    echo
    echo "============================================================"
    echo "Claude cleanup complete"
    echo "============================================================"
}


# ===========================================================================
# Handle rm before doing any project-specific setup.
# ===========================================================================

if [[ "${1:-}" == "rm" ]]; then
    remove_all
    exit 0
fi


# ===========================================================================
# Normal Claude startup
# ===========================================================================

echo "Starting Claude for project: $PROJECT_DIR"
echo "Container project path: $CONTAINER_PROJECT_DIR"


# ---------------------------------------------------------------------------
# Wayland
# ---------------------------------------------------------------------------

if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    WAYLAND_SOCKET="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"

    if [[ ! -S "$WAYLAND_SOCKET" ]]; then
        echo "Warning: Wayland socket not found: $WAYLAND_SOCKET"
    fi
fi


# ---------------------------------------------------------------------------
# Safety checks
# ---------------------------------------------------------------------------

# Don't allow the project itself to be HOME or a parent of HOME.
if [[ "$PROJECT_DIR" == "$HOME" || "$HOME/" == "$PROJECT_DIR/"* ]]; then
    echo "Refusing to run: project directory is HOME or contains HOME."
    exit 1
fi


# ---------------------------------------------------------------------------
# Verify Containerfiles exist.
# ---------------------------------------------------------------------------

if [[ ! -f "$BASE_CONTAINERFILE" ]]; then
    echo "Base Containerfile not found: $BASE_CONTAINERFILE"
    exit 1
fi

if [[ ! -f "$CLAUDE_CONTAINERFILE" ]]; then
    echo "Claude Containerfile not found: $CLAUDE_CONTAINERFILE"
    exit 1
fi


# ===========================================================================
# Build base image
# ===========================================================================

if ! podman image exists "$BASE_IMAGE_NAME"; then
    echo
    echo "Podman image '$BASE_IMAGE_NAME' does not exist."
    echo "Building base image from:"
    echo "  $BASE_CONTAINERFILE"
    echo

    podman build \
        --file "$BASE_CONTAINERFILE" \
        --tag "$BASE_IMAGE_NAME" \
        "$CONTAINERFILE_DIR"
else
    echo "Base image '$BASE_IMAGE_NAME' already exists."
fi


# ===========================================================================
# Build Claude image
# ===========================================================================

if ! podman image exists "$IMAGE_NAME"; then
    echo
    echo "Podman image '$IMAGE_NAME' does not exist."
    echo "Building Claude image from:"
    echo "  $CLAUDE_CONTAINERFILE"
    echo

    podman build \
        --file "$CLAUDE_CONTAINERFILE" \
        --tag "$IMAGE_NAME" \
        "$CONTAINERFILE_DIR"
else
    echo "Claude image '$IMAGE_NAME' already exists."
fi


# ===========================================================================
# Shell mode
#
# "sh" means: open a shell in the EXISTING project container.
# Never create a container in this mode.
# ===========================================================================

if [[ "${1:-}" == "sh" ]]; then

    if ! podman container exists "$CONTAINER_NAME"; then
        echo "Container '$CONTAINER_NAME' does not exist."
        echo "Start Claude normally first to create it."
        exit 1
    fi

    # Start the container if it isn't running.
    if [[ "$(podman inspect -f '{{.State.Running}}' "$CONTAINER_NAME")" != "true" ]]; then
        echo "Starting stopped container '$CONTAINER_NAME'."
        podman start "$CONTAINER_NAME" >/dev/null
    fi

    echo "Opening shell in '$CONTAINER_NAME'."

    exec podman exec -it \
        --workdir "$CONTAINER_PROJECT_DIR" \
        "$CONTAINER_NAME" \
        bash
fi


# ===========================================================================
# Reuse existing container for THIS project.
# ===========================================================================

if podman container exists "$CONTAINER_NAME"; then
    echo "Reusing existing container '$CONTAINER_NAME'."

    exec podman start -ai "$CONTAINER_NAME"
fi


# ===========================================================================
# Claude persistent state
# ===========================================================================

mkdir -p "$HOME/.claude"


# ===========================================================================
# Create container for the first time.
# ===========================================================================

echo
echo "Creating container '$CONTAINER_NAME'."
echo

exec podman run -it \
    --name "$CONTAINER_NAME" \
    --userns=keep-id \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --network=host \
    -e XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
    -e HOME=/home/agentuser \
    -e XDG_CONFIG_HOME=/home/agentuser/.config \
    -e XDG_DATA_HOME=/home/agentuser/.local/share \
    -e XDG_CACHE_HOME=/home/agentuser/.cache \
    -e ANDROID_HOME=/home/agentuser/Android/Sdk \
    -v "$HOME/.claude:/home/agentuser/.claude:rw,Z" \
    -v "$PROJECT_DIR:$CONTAINER_PROJECT_DIR:rw,Z" \
    -w "$CONTAINER_PROJECT_DIR" \
    "$IMAGE_NAME"
